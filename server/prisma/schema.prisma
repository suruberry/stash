generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Day {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  stickers  String[]
  mood      String?
  color     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}